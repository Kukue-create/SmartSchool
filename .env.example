APP_NAME="SmartSchool Zimbabwe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartschool_zimbabwe
DB_USERNAME=postgres
DB_PASSWORD=

# Set a strong secret password for the single System Administrator / owner login.
# This is NOT a per-user account - it is the one "owner" password mentioned in the
# project brief. Change this before deploying.
SYSTEM_ADMIN_PASSWORD=ChangeThisStrongPassword!2026

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=180

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@seke1.ac.zw"
MAIL_FROM_NAME="${APP_NAME}"

SCHOOL_STUDENT_EMAIL_DOMAIN=students.seke1.ac.zw
SCHOOL_TEACHER_EMAIL_DOMAIN=staff.seke1.ac.zw
SCHOOL_ADMIN_EMAIL_DOMAIN=admin.ac.zw
